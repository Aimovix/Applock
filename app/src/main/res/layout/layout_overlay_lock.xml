<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Ziel-App Icon oder Schutz-Badge -->
    <ImageView
        android:id="@+id/img_target_app_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="@string/lock_screen_title"
        android:src="@android:drawable/ic_lock_lock" />

    <!-- Name der geschützten Anwendung -->
    <TextView
        android:id="@+id/tv_target_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lock_screen_title"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Sicherheitshinweis -->
    <TextView
        android:id="@+id/tv_lock_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/lock_screen_subtitle"
        android:textAlignment="center"
        android:textColor="#94A3B8"
        android:textSize="15sp" />

    <!-- Großer Entsperr-Button -->
    <Button
        android:id="@+id/btn_unlock_biometric"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="36dp"
        android:backgroundTint="#0284C7"
        android:text="@string/lock_screen_unlock_btn"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Sicherer Home-Button -->
    <Button
        android:id="@+id/btn_go_home"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:text="@string/lock_screen_home_btn"
        android:textColor="#94A3B8"
        android:textSize="14sp" />

</LinearLayout>
