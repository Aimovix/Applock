<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/img_lock_icon"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="Sperrsymbol"
        android:src="@android:drawable/ic_lock_lock"
        android:tint="#38BDF8" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="App geschützt"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Diese Anwendung erfordert biometrische Authentifizierung"
        android:textAlignment="center"
        android:textColor="#94A3B8"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btn_unlock_biometric"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="36dp"
        android:backgroundTint="#0284C7"
        android:text="Mit Fingerabdruck / 3D-Gesicht entsperren"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_go_home"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:text="Zurück zum Startbildschirm"
        android:textColor="#94A3B8"
        android:textSize="14sp" />

</LinearLayout>
